# Participant-level inputs and generated outputs are never committed.
/data/*
!/data/README.md
!/data/supplement_aggregates.json
/outputs/
.venv/
__pycache__/
*.pyc
.DS_Store
*.npy
*.npz
*.pkl
*.parquet
*.sqlite
*.db
*.dylib
*.so
**/build/
# Historical workflow writes local inputs/outputs here.
/legacy/v17/data/*
!/legacy/v17/data/README.md
/legacy/v17/out/
/legacy/v17/_verify_scratch/
/legacy/v17/*.png
/legacy/v17/verify_report.md
.env
.env.*

# Tabular data: never commit participant-level files.
# Aggregate reference outputs are the only exception.
*.csv
*.tsv
*.xlsx
!paper/reference/**/*.csv
/out/
